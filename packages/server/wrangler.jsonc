{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "job-farm-monitor",
  "main": "src/entry.cloudflare.ts",
  "compatibility_date": "2026-10-29",
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "JfmStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JfmStore"] }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets (never in vars): wrangler secret put READ_TOKEN / WRITE_TOKENS
  // Local dev: packages/server/.dev.vars (gitignored) with READ_TOKEN=... WRITE_TOKENS=...
}
