{
  "name": "@jfm/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hono API with Cloudflare (DO SQLite), Node/Railway (node:sqlite) and Vercel (libSQL) entries",
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --passWithNoTests",
    "test:workers": "vitest run -c vitest.workers.config.ts --passWithNoTests",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/vercel": "1.0.1",
    "@jfm/core": "*",
    "@libsql/client": "0.18.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "tsup": "8.5.0",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
