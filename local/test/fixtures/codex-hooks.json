{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.codex/bin/heavy-gate-hook",
            "statusMessage": "Checking browser memory gate",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '$HOME/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
